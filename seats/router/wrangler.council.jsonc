{
  // ONE Cloudflare Worker for all Council seats, durable steps and protected intake.
  "name": "council-router",
  "main": "workflow-entry.js",
  "compatibility_date": "2026-11-18",
  "workers_dev": true,
  // Preserve dashboard-managed variables when future production deploys run.
  // Existing encrypted Worker secrets remain Cloudflare-managed.
  "keep_vars": true,
  // Enable eligible Workers Trace Events for the account Logpush dataset.
  // Data export still requires a separate verified destination + Logpush job.
  "logpush": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
    "logs": {"enabled": true, "invocation_logs": true, "persist": true, "head_sampling_rate": 1},
    "traces": {"enabled": true, "persist": true, "head_sampling_rate": 1},
    "issues": {"enabled": true}
  },
  "ratelimits": [{
    "name": "COUNCIL_RATE_LIMITER",
    "namespace_id": "71302401",
    "simple": {"limit": 20, "period": 60}
  }],
  "workflows": [{
    "name": "council-approval-flow",
    "binding": "COUNCIL_DURABLE",
    "class_name": "CouncilApprovalWorkflow"
  }],
  "queues": {
    "producers": [{"queue": "council-intake", "binding": "COUNCIL_INTAKE"}],
    "consumers": [{
      "queue": "council-intake",
      "max_batch_size": 1,
      "max_batch_timeout": 5,
      "max_retries": 3,
      "dead_letter_queue": "council-intake-dlq"
    }]
  },
  // Cloudflare Cron is UTC; metadata heartbeat only; never starts AI execution.
  "triggers": {"crons": ["0 12 * * *"]},
  // Mirrors the current deployed model; the other seats still fail closed.
  // Store provider secrets only as Cloudflare Worker secrets.
  "vars": {
    "SEAT_MODEL_CHATGPT": "gpt-6.2-sol",
    "SEAT_MODEL_CLAUDE": "",
    "SEAT_MODEL_DEEPSEEK": "",
    "SEAT_MODEL_MUSE": "",
    "SEAT_MODEL_PERPLEXITY": ""
  },
  // Isolated, fail-closed Preview Base. No production Queue, Workflow, or
  // provider secrets are copied into Preview environments.
  "previews": {
    "observability": {
      "enabled": true,
      "head_sampling_rate": 1,
      "issues": { "enabled": true },
      "logs": {
        "enabled": true,
        "head_sampling_rate": 1,
        "invocation_logs": true,
        "persist": true
      },
      "traces": {
        "enabled": true,
        "head_sampling_rate": 1,
        "persist": true
      }
    }
  }
}
